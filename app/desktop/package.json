{
  "name": "pocket-deck-desktop",
  "productName": "Pocket Deck",
  "desktopName": "pocket-deck-desktop.desktop",
  "version": "1.2.0-beta.1",
  "private": true,
  "description": "Pocket Deck desktop companion for Windows, Ubuntu and macOS",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test-backend.cjs test-chrome-setup.cjs test-linux-chrome.cjs test-updates.cjs test-linux-deb-update.cjs test-runtime-paths.cjs test-sandbox-policy.cjs test-mac-chrome.cjs",
    "package": "electron-builder --win nsis --x64 --publish never",
    "package:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "package:mac": "electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.pocket-deck.desktop",
    "productName": "Pocket Deck",
    "directories": {
      "output": "../desktop-dist"
    },
    "files": [
      "main.cjs",
      "backend.cjs",
      "chrome-setup.cjs",
      "linux-chrome.cjs",
      "linux-install-state.cjs",
      "linux-deb-update.cjs",
      "sandbox-policy.cjs",
      "preload.cjs",
      "renderer.js",
      "index.html",
      "desktop.css",
      "icon.png",
      "package.json",
      "updates.cjs",
      "runtime-paths.cjs",
      "mac-chrome.cjs"
    ],
    "extraResources": [
      {
        "from": "backend-build/PocketDeckServer",
        "to": "backend"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../license-notices",
        "to": "license-notices"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "masa-dev-2000 <masa-dev-2000@users.noreply.github.com>",
      "category": "Utility",
      "icon": "icon.png",
      "artifactName": "Pocket-Deck-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "masa-dev-2000",
      "repo": "pocket-deck",
      "releaseType": "release"
    },
    "artifactName": "Pocket-Deck-Setup-${version}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "icon.png",
      "artifactName": "Pocket-Deck-${version}-${arch}.${ext}",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    }
  },
  "license": "MIT",
  "author": "masa-dev-2000",
  "repository": {
    "type": "git",
    "url": "https://github.com/masa-dev-2000/pocket-deck.git",
    "directory": "app/desktop"
  },
  "homepage": "https://github.com/masa-dev-2000/pocket-deck",
  "bugs": {
    "url": "https://github.com/masa-dev-2000/pocket-deck/issues"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "semver": "7.8.5"
  }
}
