{
  "manifest_version": 3,
  "name": "Pocket Deck Profile Bridge",
  "version": "1.0.2",
  "description": "Pocket Deckから、このChromeプロフィールのウィンドウへ切り替えます。",
  "permissions": [
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pocket Deck プロフィール連携"
  },
  "key": ""
}
